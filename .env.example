# =======================================================
# AI-Based Lost and Found System Environment Variables
# =======================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# If left as mongodb://127.0.0.1:27017/lost-and-found and no MongoDB daemon is running,
# the backend automatically boots an in-memory MongoMemoryServer instance.
MONGODB_URI=mongodb://127.0.0.1:27017/lost-and-found

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-for-ai-lost-found-2026
JWT_EXPIRES_IN=7d

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# Matching Engine Configuration
# Matches >= MATCH_THRESHOLD are classified as high-confidence and trigger notifications
MATCH_THRESHOLD=0.75
# Matches >= POSSIBLE_MATCH_THRESHOLD and < MATCH_THRESHOLD appear as recommendations
POSSIBLE_MATCH_THRESHOLD=0.60
# Weights for hybrid scoring: final = (w_text * S_text + w_image * S_image) / (w_text + w_image)
WEIGHT_TEXT=0.50
WEIGHT_IMAGE=0.50

# Optional Features
FEATURE_EMAIL_NOTIFICATIONS=false

# Default Seeded Administrator Credentials
ADMIN_EMAIL=admin@lostfound.local
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=System Administrator
ADMIN_PHONE=+1-555-0199

# ML Models (used by Python FastAPI microservice)
TEXT_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
IMAGE_MODEL_NAME=openai/clip-vit-base-patch32
